    end ImportedTypes;
  annotation(Diagram(coordinateSystem(extent={{-100,-100},{100,100}}, 
grid={2,2})));

  initial equation

  for i in 1:20 loop
  h_20[i] = 1500;
  T_wall[i] = 325.15;
  //trans[i] = 273.15;
  //T_wall_degC[i] = 50;
  end for;



equation
h_cal1.new_variables = {tin, pin, g, q};
  for i in 1:20 loop
    R_1[i] = 0.7569 / (0.0192 * T_wall_degC[i] + 6.1255);

    //T_tube[i] = port_b[i].T - fix;
    //热力状态
    //state_pT = Medium.setState_pTX(p_tube, T_tube);
    //导热系数
    //lambda[i] = lamdba(p_tube,T_tube[i]);
    h_20[i]= h_cal1.output1[i];
    R_2[i] = 606.6 / h_20[i];

    //R_3[i] = R_contact[i];
    R_add[i] = R_1[i] + R_2[i];
    h_cal1.new_variables[4]/20 = (T_wall[i]-tb[i])/R_add[i];
    T_wall[i] = T_wall_degC[i] + 273.15;
    end for;
  end py_h2;